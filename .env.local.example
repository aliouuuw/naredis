# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — local PostgreSQL 17 in dev; Neon on Vercel preview/prod
DATABASE_URL=postgresql://localhost:5432/ndouckmane_transit_dev
# Neon: use the *pooled* URL for the app (Vercel → DATABASE_URL).
# Use the *direct / non-pooled* URL for migrations (Vercel → DATABASE_URL_UNPOOLED).
# If the Neon integration only exposes one variable, map the non-pooling URL here.
# DATABASE_URL_UNPOOLED=

# Better Auth (PLAT-005)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Dev admin (created by bun run db:seed — login only, no public signup)
SEED_ADMIN_EMAIL=admin@demo-transit.sn
SEED_ADMIN_PASSWORD=DemoAdmin2026!
# SEED_ADMIN_RESET_PASSWORD=true
# ALLOW_DEV_SEED=true

# Cloudflare R2 (optional until document uploads are wired)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
